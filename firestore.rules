rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userBusinessId() {
      return userDoc().data.businessId;
    }

    function isBusinessMember(businessId) {
      return isEmailVerified()
        && userExists()
        && userBusinessId() == businessId;
    }

    function isOnboardingUserUpdate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && resource.data.businessId == null
        && request.resource.data.businessId is string
        && request.resource.data.businessName is string
        && request.resource.data.businessType is string
        && request.resource.data.recordsLimit is int
        && request.resource.data.recordsLimit >= 50
        && request.resource.data.onboardingCompleted == true
        && request.auth.token.email_verified == true
        && request.resource.data.emailVerified == true;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'owner'
        && request.resource.data.emailVerified == false;

      allow read: if signedIn()
        && request.auth.uid == userId;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && (
          (
            request.resource.data.businessId == resource.data.businessId
            && (
              request.resource.data.emailVerified == resource.data.emailVerified
              || (
                request.resource.data.emailVerified == true
                && resource.data.emailVerified == false
                && request.auth.token.email_verified == true
              )
            )
          )
          || isOnboardingUserUpdate(userId)
        );

      allow delete: if false;
    }

    match /businesses/{businessId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.businessId == businessId
        && (
          request.resource.data.status == 'pending_verification'
          || (
            request.resource.data.status == 'active'
            && request.auth.token.email_verified == true
          )
        );

      allow read: if isBusinessMember(businessId);

      allow update: if isBusinessMember(businessId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.businessId == resource.data.businessId;

      allow delete: if false;

      match /{subCollection}/{docId} {
        allow read, write: if isBusinessMember(businessId);
      }

      match /{subCollection}/{docId}/{nested=**} {
        allow read, write: if isBusinessMember(businessId);
      }
    }
  }
}
