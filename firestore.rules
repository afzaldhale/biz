rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function tokenVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function userDocVerified() {
      return userExists() && userDoc().data.emailVerified == true;
    }

    function isVerifiedUser() {
      return tokenVerified() || userDocVerified();
    }

    function userBusinessId() {
      return userDoc().data.businessId;
    }

    function preservesUserIdentity(userId) {
      return isSelf(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;
    }

    function hasBusiness(resourceData) {
      return 'businessId' in resourceData && resourceData.businessId != null;
    }

    function isBusinessMember(businessId) {
      return isVerifiedUser()
        && userExists()
        && userBusinessId() == businessId;
    }

    match /users/{userId} {
      allow create: if isSelf(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'owner'
        && request.resource.data.emailVerified == false;

      allow read: if isSelf(userId);

      allow update: if preservesUserIdentity(userId)
        && (
          (
            !hasBusiness(resource.data)
            && (
              !hasBusiness(request.resource.data)
              || request.resource.data.businessId is string
            )
          )
          || (
            hasBusiness(resource.data)
            && request.resource.data.businessId == resource.data.businessId
          )
        );

      allow delete: if false;
    }

    match /businesses/{businessId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.businessId == businessId
        && isVerifiedUser();

      allow read: if isBusinessMember(businessId);

      allow update: if isBusinessMember(businessId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.businessId == resource.data.businessId;

      allow delete: if false;

      match /{subCollection}/{docId} {
        allow read, write: if isBusinessMember(businessId);
      }

      match /{subCollection}/{docId}/{nested=**} {
        allow read, write: if isBusinessMember(businessId);
      }
    }
  }
}
